# Server configuration. Only the two cookie values are yours to fill in.
PORT=3000

# ---------------------------------------------------------------------------
# Your own X login cookies (the ONLY personal values needed).
# Log in to x.com, press F12 -> Application -> Cookies -> https://x.com.
# Click "auth_token", copy its Value below. Click "ct0", copy its Value below.
# ---------------------------------------------------------------------------

# EXAMPLE format (40 hex characters - replace with your real cookie value):
X_AUTH_TOKEN=0123456789abcdef0123456789abcdef01234567

# EXAMPLE format (32 hex characters - replace with your real cookie value):
X_CT0=abcdef0123456789abcdef0123456789

# Optional overrides. X's Authorization Bearer token and User-Agent are public
# web-client identifiers, identical for everyone - the server already uses the
# same defaults as x_gift_bot's setup wizard. Set these ONLY if X rejects them.
#X_AUTHORIZATION=Bearer ...
#X_USER_AGENT=Mozilla/5.0 ...

# Merchant (connected Stripe account). Already filled - do not change.
MERCHANT_ACCOUNT_ID=acct_1Ika5JA3KZ32dPo1
