# Server configuration. Replace every EXAMPLE value with your own (see HOW below).
PORT=3000

# ---------------------------------------------------------------------------
# HOW to get each value (all from YOUR OWN logged-in browser, nothing to sign
# up for). Log in to x.com first, then press F12 for DevTools:
#
#   X_AUTH_TOKEN + X_CT0:
#     DevTools -> Application -> Cookies -> https://x.com.
#     Click "auth_token", copy its Value. Click "ct0", copy its Value.
#
#   X_AUTHORIZATION + X_USER_AGENT:
#     DevTools -> Network -> trigger any x.com action (or reload) ->
#     click any request to x.com/i/api/... -> Headers ->
#     copy the full "authorization" value (starts with "Bearer ") and
#     the full "user-agent" value.
# ---------------------------------------------------------------------------

# EXAMPLE format (40 hex characters - replace with your real cookie value):
X_AUTH_TOKEN=0123456789abcdef0123456789abcdef01234567

# EXAMPLE format (32 hex characters - replace with your real cookie value):
X_CT0=abcdef0123456789abcdef0123456789

# EXAMPLE format (starts with "Bearer " followed by a long token -
# replace with the FULL value from your DevTools Network tab):
X_AUTHORIZATION=Bearer AAAAAAAAAAAAAAAAAAAAEXAMPLEEXAMPLEEXAMPLEEXAMPLEEXAMPLE

# EXAMPLE format (your browser's User-Agent - replace with yours from DevTools):
X_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36

# Merchant (connected Stripe account). Already filled - do not change.
MERCHANT_ACCOUNT_ID=acct_1Ika5JA3KZ32dPo1
